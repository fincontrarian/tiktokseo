// Prisma schema for Findable.
//
// Creator, Video, NicheKeyword, and NicheBenchmark are part of our index —
// populated by the internal ingestion pipeline and READ by this app.
// Metadata only: captions, hashtags, counts, URLs, public profile fields.
// Lead is the only table this app writes to today.
//
// The database connection URL lives in prisma.config.ts (Prisma 7+).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Creator {
  id            String   @id @default(cuid())
  handle        String   @unique
  displayName   String
  bio           String
  followerCount Int
  niche         String
  videos        Video[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([niche])
}

model Video {
  id            String         @id @default(cuid())
  creatorId     String
  creator       Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption       String
  hashtags      String[]
  postedAt      DateTime
  views         Int
  likes         Int
  comments      Int
  bookmarks     Int
  url           String?
  videoHashtags VideoHashtag[]

  @@index([creatorId, postedAt(sort: Desc)])
}

/// One row per (video, hashtag) — supports co-occurrence queries.
model VideoHashtag {
  videoId String
  hashtag String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, hashtag])
  @@index([hashtag])
}

/// A searchable keyword in our index, per content locale.
model Keyword {
  id      String             @id @default(cuid())
  term    String
  locale  String
  stats   KeywordStatDaily[]
  tracked TrackedKeyword[]

  @@unique([locale, term])
}

/// Daily snapshot of a keyword's footprint in the index.
model KeywordStatDaily {
  id         String   @id @default(cuid())
  keywordId  String
  keyword    Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  videoCount Int
  totalViews BigInt

  @@unique([keywordId, date])
  @@index([keywordId, date(sort: Desc)])
}

/// A keyword a user asked to track (rank tracking ships later).
model TrackedKeyword {
  id        String   @id @default(cuid())
  userId    String
  keywordId String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, keywordId])
  @@index([userId])
}

model NicheKeyword {
  id            String @id @default(cuid())
  niche         String
  keyword       String
  monthlyVolume Int
  rank          Int

  @@unique([niche, keyword])
  @@index([niche, rank])
}

model NicheBenchmark {
  niche                String @id
  medianPostsPerWeek   Float
  medianEngagementRate Float
  medianSaveRate       Float
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  handle    String?
  source    String
  locale    String   @default("en")
  createdAt DateTime @default(now())

  @@unique([email, source])
  @@index([createdAt])
}
