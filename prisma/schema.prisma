// Prisma schema for Findable.
//
// Creator, Video, NicheKeyword, and NicheBenchmark are part of our index —
// populated by the internal ingestion pipeline and READ by this app.
// Metadata only: captions, hashtags, counts, URLs, public profile fields.
// Lead is the only table this app writes to today.
//
// The database connection URL lives in prisma.config.ts (Prisma 7+).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Creator {
  id             String             @id @default(cuid())
  handle         String             @unique
  displayName    String
  bio            String
  followerCount  Int
  niche          String
  /// When our ingestion pipeline first saw this profile — usually long
  /// before the creator signs up, which is the dashboard's wow moment.
  firstSeenAt    DateTime           @default(now())
  videos         Video[]
  statsDaily     CreatorStatDaily[]
  trackedBy      TrackedProfile[]
  profileEvents  ProfileEvent[]
  auditSnapshots AuditSnapshot[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([niche])
}

/// Daily profile stats from our index. Populated by the ingestion pipeline;
/// history predates user signups.
model CreatorStatDaily {
  id               String   @id @default(cuid())
  creatorId        String
  creator          Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  followerCount    Int
  avgViewsPerVideo Float
  engagementRate   Float
  saveRate         Float

  @@unique([creatorId, date])
  @@index([creatorId, date(sort: Desc)])
}

/// A profile a user tracks on their dashboard. Limits come from lib/plan.ts.
model TrackedProfile {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, creatorId])
  @@index([userId])
}

/// A user-logged optimization event ("changed bio"), rendered as a vertical
/// annotation on every dashboard chart.
model ProfileEvent {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  label     String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, creatorId, date])
}

/// Stored audit runs so the dashboard can show score deltas over time.
model AuditSnapshot {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  score     Int
  grade     String
  createdAt DateTime @default(now())

  @@index([creatorId, createdAt(sort: Desc)])
}

/// Generated sitemap files (gzipped XML), rebuilt by the sitemap cron.
model SitemapFile {
  name        String   @id
  content     Bytes
  urlCount    Int
  generatedAt DateTime @default(now())
}

/// Composed weekly digest emails (stub: stored, not sent).
model Digest {
  id        String   @id @default(cuid())
  userId    String
  weekStart DateTime @db.Date
  subject   String
  body      String
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

model Video {
  id            String         @id @default(cuid())
  creatorId     String
  creator       Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  caption       String
  hashtags      String[]
  postedAt      DateTime
  views         Int
  likes         Int
  comments      Int
  bookmarks     Int
  url           String?
  videoHashtags VideoHashtag[]

  @@index([creatorId, postedAt(sort: Desc)])
}

/// One row per (video, hashtag) — supports co-occurrence queries.
model VideoHashtag {
  videoId String
  hashtag String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, hashtag])
  @@index([hashtag])
}

/// A searchable keyword in our index, per content locale.
model Keyword {
  id      String             @id @default(cuid())
  term    String
  locale  String
  stats   KeywordStatDaily[]
  tracked TrackedKeyword[]

  @@unique([locale, term])
}

/// Daily snapshot of a keyword's footprint in the index.
model KeywordStatDaily {
  id         String   @id @default(cuid())
  keywordId  String
  keyword    Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  videoCount Int
  totalViews BigInt

  @@unique([keywordId, date])
  @@index([keywordId, date(sort: Desc)])
}

/// A keyword a user asked to track (rank tracking ships later).
model TrackedKeyword {
  id        String   @id @default(cuid())
  userId    String
  keywordId String
  keyword   Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, keywordId])
  @@index([userId])
}

model NicheKeyword {
  id            String @id @default(cuid())
  niche         String
  keyword       String
  monthlyVolume Int
  rank          Int

  @@unique([niche, keyword])
  @@index([niche, rank])
}

model NicheBenchmark {
  niche                String @id
  medianPostsPerWeek   Float
  medianEngagementRate Float
  medianSaveRate       Float
}

model Lead {
  id              String    @id @default(cuid())
  email           String
  handle          String?
  source          String
  locale          String    @default("en")
  createdAt       DateTime  @default(now())
  /// Set when the lead signs up: they become a user on first login.
  convertedUserId String?
  convertedAt     DateTime?

  @@unique([email, source])
  @@index([createdAt])
  @@index([email])
}

// --- Auth (NextAuth / Auth.js database sessions) -----------------------------

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String           @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime         @default(now())
  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Billing ------------------------------------------------------------------

/// Mirror of the user's Stripe subscription, maintained by the webhook
/// handler. getUserPlan() resolves the effective plan from this table —
/// the single source of truth for entitlements.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String
  stripeSubscriptionId String    @unique
  /// "creator" | "pro" — from price metadata at checkout.
  plan                 String
  /// Stripe subscription status: trialing, active, past_due, canceled...
  status               String
  interval             String    @default("month")
  trialEnd             DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, status])
  @@index([stripeCustomerId])
}

/// Upgrade-gate impressions: which gated surface was shown (and later, which
/// converts). `gate` matches the /pricing?from= attribution value.
model GateEvent {
  id        String   @id @default(cuid())
  userId    String?
  gate      String
  kind      String   @default("impression")
  path      String
  locale    String   @default("en")
  createdAt DateTime @default(now())

  @@index([gate, createdAt])
  @@index([userId, createdAt])
}
