# Local development defaults. Copy to .env (scripts/setup-local.sh does this
# for you and fills in AUTH_SECRET). Values match docker-compose.yml.

# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findable"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth (Auth.js) -----------------------------------------------------
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Optional: enables the "Continue with Google" button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: without it, magic links are printed to the dev-server console
# and served from /api/dev/magic-link?email=...
RESEND_API_KEY=""
EMAIL_FROM="Findable <login@findable.app>"

# --- Billing (Stripe) ---------------------------------------------------
# Locally the SDK talks to stripe-mock; build it once with
#   GOBIN=$PWD/.bin go install github.com/stripe/stripe-mock@latest
# and run .bin/stripe-mock -port 12111. In production, remove STRIPE_API_BASE
# and use real keys.
STRIPE_API_BASE="http://localhost:12111"
STRIPE_SECRET_KEY="sk_test_123"
STRIPE_WEBHOOK_SECRET="whsec_local_dev_secret"

# --- Optional tuning ----------------------------------------------------
# Bearer token required by /api/cron/* when set.
CRON_SECRET=""
# Public audits per IP per hour (default 10).
AUDIT_RATE_LIMIT_PER_HOUR=""
# Cap on programmatic SEO pages in sitemaps.
SEO_PAGE_LIMIT=""
